# Local environment.
#
#   docker compose --env-file env.local up -d
#   docker compose --env-file env.local -f docker-compose.yml -f docker-compose.services.yml up -d --build
#

# Development-only containers (Mailpit, pgAdmin) are behind the `dev` compose profile.
COMPOSE_PROFILES=dev

# --- PostgreSQL --------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=derechi
POSTGRES_USER=derechi
POSTGRES_PASSWORD=derechi

# --- RabbitMQ ----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=derechi
RABBITMQ_PASSWORD=derechi
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# --- API entry (Caddy) -------------------------------------------------------------------
CLIENT_API_URI=http://client-api:8082
GRAPHIQL_ENABLED=true

# --- Keycloak ----------------------------------------------------------------------------
KEYCLOAK_URI=http://keycloak:8080
KEYCLOAK_PUBLIC_URI=http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_SERVICES_SECRET=dev-secret-change-me
DERECHI_ADMIN_URL=http://localhost:8083
KEYCLOAK_JAVA_OPTS="-Xms64m -Xmx156m -XX:MaxMetaspaceSize=156m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -XX:-UseG1GC -XX:+UseSerialGC"

# --- MinIO -------------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_URI=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000/derechi-files
MINIO_ROOT_USER=derechi
MINIO_ROOT_PASSWORD=derechi123
MINIO_ACCESS_KEY=derechi-app
MINIO_SECRET_KEY=derechi-app-secret
MINIO_REGION=us-east-1
MINIO_BUCKET=derechi-files

# --- Web client --------------------------------------------------------------------------
DERECHI_SITE_URL=http://localhost:3000

# --- E-mail (Mailpit) --------------------------------------------------------------------
NOTIFY_EMAIL_HOST=mailpit
NOTIFY_EMAIL_PORT=1025
NOTIFY_EMAIL_USERNAME=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_FROM=no-reply@derechi.local

# --- SMS (SMS-fly); empty key = SMS off, a real key sends real, billed SMS ---------------
SMS_FLY_API_KEY=
SMS_FLY_API_URL=https://sms-fly.ua/api/v2/api.php
SMS_FLY_SOURCE=DeRechi

# --- Fourthwall --------------------------------------------------------------------------
FOURTHWALL_SHOP_URL=https://derechi-shop.fourthwall.com
FOURTHWALL_API_USERNAME=dev-namess
FOURTHWALL_API_PASSWORD=dev-password
FOURTHWALL_WEBHOOK_SECRET=dev-secret
FOURTHWALL_PRODUCT_IMAGE_URL=

# --- JVM of the Spring services ----------------------------------------------------------
JAVA_OPTS="-Xms64m -Xmx156m -XX:MaxMetaspaceSize=156m -XX:ReservedCodeCacheSize=34m -XX:MaxDirectMemorySize=34m -XX:-UseG1GC -XX:+UseSerialGC"

# --- Alerts (Alertmanager; locally into Mailpit) -----------------------------------------
ALERT_EMAIL_TO=alerts@derechi.local
ALERT_SMTP_HOST=mailpit:1025
ALERT_SMTP_FROM=alertmanager@derechi.local
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=false

# --- Consoles ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PGADMIN_DEFAULT_EMAIL=admin@derechi.local
PGADMIN_DEFAULT_PASSWORD=admin


# --- Ingest ------------------------------------------------------------------------------
# Where notices go: site (Client-API), channel (our Telegram channel, needs site).
# Empty is a dry run: notices are only recorded as PREVIEWED; site,channel publishes.
INGEST_PUBLISHERS=
# HMAC key of phone_hash (duplicate detection); changing it forgets every known phone.
INGEST_HASH_KEY=dev-hash-key-change-me
INGEST_DUPLICATE_WINDOW=P14D
INGEST_MAX_PHOTOS=3
# Older notices are skipped (Client-API accepts 30 days).
INGEST_MAX_AGE=P30D
# Language of the site links in captions.
INGEST_SITE_LOCALE=uk
# Extractions with a lower model confidence are skipped (outcome rejected).
INGEST_MIN_CONFIDENCE=0.6
# The application from my.telegram.org.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Only for the one-off --login run.
TELEGRAM_PHONE=
# Name of the Telegram folder whose chats are read.
TELEGRAM_FOLDER=DeRechi
# Per-chat overrides: username=city[|region[|locale]];... (the chat's default city).
TELEGRAM_CHATS=zagubleno911=Львів
TELEGRAM_DEFAULT_REGION=UA
TELEGRAM_DEFAULT_LOCALE=uk
# How long to wait for the rest of a post: album parts, or a text and its photos sent separately.
TELEGRAM_ALBUM_WAIT=PT3S
TELEGRAM_FOLDER_REFRESH=PT10M
# On start, posts missed while down are read back this far, at most this many per chat.
TELEGRAM_CATCH_UP_MAX_AGE=PT48H
TELEGRAM_CATCH_UP_MAX_MESSAGES=200
FACEBOOK_COOKIES=
FACEBOOK_GROUPS=zzter=Тернопіль
FACEBOOK_POLL_EVERY=PT1H
FACEBOOK_POLL_JITTER=PT20M
FACEBOOK_REQUEST_PAUSE=PT10S
FACEBOOK_MAX_PAGES=10
FACEBOOK_CATCH_UP_MAX_AGE=PT18H
FACEBOOK_ACTIVE_HOURS=
TELEGRAM_BOT_API_URL=https://api.telegram.org
# The bot that posts to our channel; to try the channel out, point PUBLISH at a private chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLISH_CHAT=
TELEGRAM_PUBLISH_LOCALE=uk
TELEGRAM_BOT_TIMEOUT=PT30S
TELEGRAM_BOT_MAX_ATTEMPTS=3
TELEGRAM_BOT_RETRY_DELAY=PT3S
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_FALLBACK_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_TIMEOUT=PT60S
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_DELAY=PT1S
# Model calls per UTC day, a safety net; over it posts are skipped (outcome budget).
OPENROUTER_DAILY_LIMIT=300
GOOGLE_PLACES_API=LEGACY
GOOGLE_PLACES_URL=
# A server key restricted by IP, not the browser key of the admin panel.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT=PT10S
GOOGLE_PLACES_MAX_ATTEMPTS=3
GOOGLE_PLACES_RETRY_DELAY=PT1S
# The API entry (Caddy) as the container sees it; notices go to its /graphql.
DERECHI_API_URI=http://caddy:8080
DERECHI_API_TIMEOUT=PT15S
DERECHI_API_MAX_ATTEMPTS=3
DERECHI_API_RETRY_DELAY=PT1S
# How long categories and countries fetched from the API are cached.
DERECHI_API_REFERENCE_TTL=1h
MINIO_MAX_UPLOAD=5MB
# Tesseract language packs installed in the image.
REDACTION_OCR_LANGUAGES=ukr+eng
# OCR finding fewer words than this on a document blurs the whole photo.
# Words that mark a photo as an ID document.
# Default list in Ingest/src/main/resources/application.yaml; set only to override it
# REDACTION_DOCUMENT_KEYWORDS=паспорт,passport,...
REDACTION_FACE_MODEL=classpath:models/face_detection_yunet_2023mar.onnx
REDACTION_FACE_SCORE=0.6
REDACTION_DOCUMENT_MODE=PARTIAL
# Tesseract, ONNX Runtime and TDLib need native memory beyond the heap.
INGEST_JAVA_OPTS="-Xms64m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:-UseG1GC -XX:+UseSerialGC --enable-native-access=ALL-UNNAMED"
INGEST_MEMORY=1g

