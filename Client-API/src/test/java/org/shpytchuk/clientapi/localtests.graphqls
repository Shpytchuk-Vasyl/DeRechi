query  {
    #    lostItem(id: 2) {
    #        id
    #        category {
    #            id
    #            key
    #        }
    #        contact {
    #            id
    #            email
    #            phone
    #        }
    #        compensation
    #        date
    #        description
    #        image
    #        place {
    #            name
    #            lat
    #            lon
    #            id
    #        }
    #        title
    #    }
    lostItems(filter: {placeId: "ChIJq6q6q6q6q6qRq6q6q6q6q6q"})
     {
        edges {
            node {
                id
                category {
                    id
                    key
                }
                contact {
                    id
                    email
                    phone
                }
                compensation
                date
                description
                image
                place {
                    name
                    lat
                    lon
                    id
                }
                title
            }
        }
        pageInfo  {
            endCursor
            startCursor
        }
    }
}
