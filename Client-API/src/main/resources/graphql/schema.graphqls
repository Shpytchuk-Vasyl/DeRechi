scalar Date

enum SocialMedia {
    TELEGRAM
    VIBER
    WHATSAPP
    SIGNAL
    MESSENGER
}

enum ItemSort {
    DATE_DESC
    DATE_ASC
    TITLE_DESC
    TITLE_ASC
}

type Category {
    id: ID!
    key: String!
}

type Place {
    id: ID!
    name: String!
    lat: Float
    lon: Float
    "ISO 3166-1 alpha-2"
    countryCode: String!
}

"Supported country"
type Country {
    "ISO 3166-1 alpha-2, uppercase"
    code: String!
    "ISO 4217 currency used for rewards in this country"
    currency: String!
}

"Reward in a concrete currency; never converted"
type Money {
    "whole units, 0 or more"
    amount: Int!
    "ISO 4217"
    currency: String!
}

type ContactInfo {
    id: ID!
    phone: String!
    email: String!
}

"Receipt for contacts handed to the author of a notice"
type Claim {
    id: ID!
    "true when this phone or email had already responded to the notice; nothing was sent again"
    repeated: Boolean!
    "Fourthwall checkout that unlocks the author's phone number; null until unlockClaim prepared it"
    checkoutUrl: String
    "The payment arrived"
    paid: Boolean!
    "The author's phone number was sent to the responder by email and SMS"
    contactsSent: Boolean!
}

"Lost Item Notice."
type LostItem {
    id: ID!
    title: String!
    description: String
    date: Date!
    "Reward for return"
    compensation: Money
    image: String
    category: Category!
    place: Place!
    contact: ContactInfo!
}

"Lost and found notice. Photo required."
type FoundItem {
    id: ID!
    title: String!
    description: String
    date: Date!
    compensation: Money
    image: String!
    category: Category!
    place: Place!
    contact: ContactInfo!
}

input ItemFilterInput {
    search: String
    categoryId: ID
    dateFrom: Date
    dateTo: Date
    near: NearInput
}

"Only items within the radius of this point"
input NearInput {
    "latitude, -90..90"
    lat: Float!
    "longitude, -180..180"
    lon: Float!
    "radius in kilometres, up to 500"
    radiusKm: Float! = 50
}

input ContactInfoInput {
    "E.164 format, for example +380671234567"
    phone: String!
    email: String!
    socialMedias: [SocialMedia!]
}

input PlaceInput {
    "ID Google Places"
    id: ID!
    name: String!
    "latitude, -90..90"
    lat: Float!
    "longitude, -180..180"
    lon: Float!
    "ISO 3166-1 alpha-2, must be a supported country"
    countryCode: String!
}

input MoneyInput {
    "whole units, 0 or more"
    amount: Int!
    "ISO 4217; defaults to the currency of the place's country"
    currency: String
}

input ItemInput {
    title: String!
    description: String
    date: Date!
    compensation: MoneyInput
    image: String
    categoryId: ID!
    place: PlaceInput!
    contact: ContactInfoInput!
}

type Query {
    lostItem(id: ID!): LostItem
    lostItems(filter: ItemFilterInput, sort: ItemSort = DATE_DESC, first: Int, after: String): LostItemConnection!

    foundItem(id: ID!): FoundItem
    foundItems(filter: ItemFilterInput, sort: ItemSort = DATE_DESC, first: Int, after: String): FoundItemConnection!

    categories: [Category!]!

    countries: [Country!]!

    "Places sorted by name; `name` is a case-insensitive substring"
    places(name: String, first: Int, after: String): PlaceConnection!

    "A response to a lost item notice, to show whether the payment arrived; null when the notice has no such response"
    lostItemClaim(itemId: ID!, id: ID!): Claim
    "A response to a found item notice, to show whether the payment arrived; null when the notice has no such response"
    foundItemClaim(itemId: ID!, id: ID!): Claim
}

type Mutation {
    createLostItem(input: ItemInput!): LostItem!
#    updateLostItem(id: ID!, input: ItemInput!): LostItem!
#    deleteLostItem(id: ID!): Boolean!

    createFoundItem(input: ItemInput!): FoundItem!
#    updateFoundItem(id: ID!, input: ItemInput!): FoundItem!
#    deleteFoundItem(id: ID!): Boolean!

    "I found this item: hand my contacts to the owner. They get them by email and SMS; nothing is shown publicly."
    claimLostItem(id: ID!, contact: ContactInfoInput!): Claim!
    "This item is mine: hand my contacts to the finder. They get them by email and SMS; nothing is shown publicly."
    claimFoundItem(id: ID!, contact: ContactInfoInput!): Claim!
    "From the link in a reminder: the item is back with its owner, so the notice can be closed. Unknown token: NOT_FOUND."
    confirmReturn(token: String!): Boolean!
    "Prepare the payment for the phone number of the lost item's owner: a product is created on Fourthwall and its checkout comes back in checkoutUrl. No such response on the notice: NOT_FOUND; Fourthwall unreachable or rate-limited: PAYMENT_UNAVAILABLE."
    unlockLostItemClaim(itemId: ID!, id: ID!): Claim!
    "The same for the phone number of the found item's finder."
    unlockFoundItemClaim(itemId: ID!, id: ID!): Claim!
}
