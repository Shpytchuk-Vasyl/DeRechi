{$API_DOMAIN::8080} {
	encode zstd gzip

	@client path /graphql /graphql/* /graphiql /graphiql/* /api/client/*
	handle @client {
		reverse_proxy {$CLIENT_API_URI:http://client-api:8082}
	}

	@upload {
		method PUT OPTIONS
		path /{$MINIO_BUCKET:derechi-files}/*
	}
	handle @upload {
		request_body {
			max_size 5MiB
		}
		reverse_proxy {$MINIO_URI:http://minio:9000}
	}

	@files {
		method GET
		path /files/*
	}
	handle @files {
		uri path_regexp ^/files/ /{$MINIO_BUCKET:derechi-files}/
		reverse_proxy {$MINIO_URI:http://minio:9000} {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		respond 404
	}
}
