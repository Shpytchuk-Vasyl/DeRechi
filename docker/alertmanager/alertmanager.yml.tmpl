# Rendered at container start: every ${VAR} is replaced with the environment variable of that
# name (see the alertmanager service in docker-compose.yml). Alertmanager itself does not read
# environment variables. Quoted values may not contain a double quote or a backslash.

global:
  smtp_smarthost: "${ALERT_SMTP_HOST}"
  smtp_from: "${ALERT_SMTP_FROM}"
  smtp_auth_username: "${ALERT_SMTP_USERNAME}"
  smtp_auth_password: "${ALERT_SMTP_PASSWORD}"
  smtp_require_tls: ${ALERT_SMTP_REQUIRE_TLS}

templates:
  - /etc/alertmanager/email.tmpl

route:
  receiver: team
  group_by: [alertname, queue, application]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: team
    email_configs:
      - to: "${ALERT_EMAIL_TO}"
        send_resolved: true
        headers:
          Subject: '{{ template "derechi.email.subject" . }}'
        html: '{{ template "derechi.email.html" . }}'
        text: '{{ template "derechi.email.text" . }}'
