      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    },
    {
      "source": "derechi.matches",
      "vhost": "/",
      "destination": "notification.matches",
      "destination_type": "queue",
      "routing_key": "match.found",
      "arguments": {}
    },
    {
      "source": "derechi.matches.dlx",
      "vhost": "/",
      "destination": "notification.matches.dlq",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    }
