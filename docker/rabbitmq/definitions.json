{
  "rabbit_version": "4.3.5",
  "rabbitmq_version": "4.3.5",
  "product_name": "RabbitMQ",
  "product_version": "4.3.5",
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "parameters": [],
  "global_parameters": [],
  "policies": [],
  "exchanges": [
    {
      "name": "notification.exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "notice.status.exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "claims.exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "notice.action.exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "dead-letter.exchange",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "notification.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dead-letter.exchange",
        "x-dead-letter-routing-key": "notification.queue"
      }
    },
    {
      "name": "notification.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "worker.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dead-letter.exchange",
        "x-dead-letter-routing-key": "worker.queue"
      }
    },
    {
      "name": "worker.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "ingest.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dead-letter.exchange",
        "x-dead-letter-routing-key": "ingest.queue"
      }
    },
    {
      "name": "ingest.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "bindings": [
    {
      "source": "notification.exchange",
      "vhost": "/",
      "destination": "notification.queue",
      "destination_type": "queue",
      "routing_key": "notification.#",
      "arguments": {}
    },
    {
      "source": "notice.status.exchange",
      "vhost": "/",
      "destination": "worker.queue",
      "destination_type": "queue",
      "routing_key": "notice.*.created",
      "arguments": {}
    },
    {
      "source": "notice.status.exchange",
      "vhost": "/",
      "destination": "worker.queue",
      "destination_type": "queue",
      "routing_key": "notice.*.returned",
      "arguments": {}
    },
    {
      "source": "claims.exchange",
      "vhost": "/",
      "destination": "worker.queue",
      "destination_type": "queue",
      "routing_key": "claim.*.claimed",
      "arguments": {}
    },
    {
      "source": "claims.exchange",
      "vhost": "/",
      "destination": "worker.queue",
      "destination_type": "queue",
      "routing_key": "claim.*.paid",
      "arguments": {}
    },
    {
      "source": "notice.action.exchange",
      "vhost": "/",
      "destination": "worker.queue",
      "destination_type": "queue",
      "routing_key": "notice.*.archive",
      "arguments": {}
    },
    {
      "source": "notice.status.exchange",
      "vhost": "/",
      "destination": "ingest.queue",
      "destination_type": "queue",
      "routing_key": "notice.*.created",
      "arguments": {}
    },
    {
      "source": "notice.status.exchange",
      "vhost": "/",
      "destination": "ingest.queue",
      "destination_type": "queue",
      "routing_key": "notice.*.archived",
      "arguments": {}
    },
    {
      "source": "notice.status.exchange",
      "vhost": "/",
      "destination": "ingest.queue",
      "destination_type": "queue",
      "routing_key": "notice.*.deleted",
      "arguments": {}
    },
    {
      "source": "dead-letter.exchange",
      "vhost": "/",
      "destination": "notification.dlq",
      "destination_type": "queue",
      "routing_key": "notification.queue",
      "arguments": {}
    },
    {
      "source": "dead-letter.exchange",
      "vhost": "/",
      "destination": "worker.dlq",
      "destination_type": "queue",
      "routing_key": "worker.queue",
      "arguments": {}
    },
    {
      "source": "dead-letter.exchange",
      "vhost": "/",
      "destination": "ingest.dlq",
      "destination_type": "queue",
      "routing_key": "ingest.queue",
      "arguments": {}
    }
  ]
}
